# Copy to .env and fill in. Never commit .env.
# kie.ai API key (https://kie.ai). Used by scripts/generate.mjs for AI images, footage and B-roll.
KIE_API_KEY=

# HeyGen API key (platform.heygen.com/api-keys, same workspace as Korede's digital twin). Bills the HeyGen API wallet.
HEYGEN_API_KEY=
# Default twin look + voice (find with: node scripts/heygen.mjs looks / voices)
HEYGEN_LOOK_ID=
HEYGEN_VOICE_ID=
# Weekly spend caps in USD
HEYGEN_WEEKLY_CAP_USD=10
KIE_WEEKLY_CAP_USD=20
